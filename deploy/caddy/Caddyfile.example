# Caddyfile for exfer-walletd
#
# Place at /etc/caddy/Caddyfile. Caddy auto-fetches a LetsEncrypt cert
# on first request and renews it; no extra config needed.
#
# Replace walletd.example.com with your real hostname.

walletd.example.com {
    # Reverse proxy to walletd on loopback.
    reverse_proxy 127.0.0.1:8080

    # Cap request body. JSON-RPC envelopes are tiny — 1 MB is generous.
    request_body {
        max_size 1MB
    }

    # Optional: lock down to known client IPs at the proxy level too.
    # Uncomment and adjust the CIDR list to match your callers.
    # @blocked not remote_ip 10.0.0.0/8 192.168.0.0/16
    # respond @blocked 403

    # Reasonable security headers for an API endpoint.
    header {
        # Don't advertise the backend.
        -Server
        # API responses are not framed.
        X-Frame-Options DENY
        # No referrers should leak from a programmatic API.
        Referrer-Policy no-referrer
        # Defense in depth for a JSON-only origin.
        X-Content-Type-Options nosniff
    }

    log {
        output file /var/log/caddy/walletd.access.log {
            roll_size 100mb
            roll_keep 14
        }
        format json
    }
}
