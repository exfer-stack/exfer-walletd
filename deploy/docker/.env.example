# Copy to .env (mode 0600) and replace the placeholder values.
#
#   cp .env.example .env
#   chmod 600 .env
#   sed -i "s|REPLACE_ME_READ|$(openssl rand -hex 32)|"  .env
#   sed -i "s|REPLACE_ME_SPEND|$(openssl rand -hex 32)|" .env
#
# Do NOT commit the resulting .env.

WALLETD_AUTH_TOKEN_READ=REPLACE_ME_READ
WALLETD_AUTH_TOKEN_SPEND=REPLACE_ME_SPEND

# Where walletd should reach the Exfer node RPC. Examples:
#   http://host.docker.internal:9334    # node on the docker host
#   http://exfer-node:9334              # node in the same compose network
#   http://10.0.0.5:9334                # node on the LAN
#   http://a:9334,http://b:9334         # HA with round-robin failover
EXFER_NODE_RPC=http://host.docker.internal:9334
