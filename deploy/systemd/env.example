# /etc/exfer-walletd/env — chown root:exfer-walletd, chmod 0640
#
# This file is read by systemd via EnvironmentFile=. Tokens never appear
# in the command line so `ps aux` won't reveal them.
#
# Generate fresh tokens with: openssl rand -hex 32

# --- Auth -------------------------------------------------------------------
# Read scope: every method except transfer / send_raw_transaction.
WALLETD_AUTH_TOKEN_READ=replace-me-64-hex-characters

# Spend scope: all methods including transfer. Spend implicitly grants read.
WALLETD_AUTH_TOKEN_SPEND=replace-me-64-hex-characters

# --- Networking -------------------------------------------------------------
# Bind loopback only; put Caddy/nginx in front for TLS termination. If you
# really need a public bind (because TLS terminates upstream of this host,
# e.g. behind k8s ingress or a cloud LB), set WALLETD_ALLOW_PUBLIC_BIND=1
# below to acknowledge the risk — without that flag, walletd refuses to
# bind any non-loopback / non-private interface.
WALLETD_BIND=127.0.0.1:8080
# WALLETD_ALLOW_PUBLIC_BIND=1

# One or more upstream Exfer node RPC URLs, comma-separated.
# Round-robin with transport-level failover.
EXFER_NODE_RPC=http://127.0.0.1:9334

# --- Storage ----------------------------------------------------------------
WALLETD_WALLET_DIR=/var/lib/exfer-walletd

# --- Misc -------------------------------------------------------------------
RUST_LOG=info,exfer_walletd=info
WALLETD_UPSTREAM_TIMEOUT_SECS=30
